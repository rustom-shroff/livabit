{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capabilities.schema.json",
  "title": "OAP 0.1.0 capability document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "role",
    "supported_versions",
    "event_names",
    "metrics",
    "application_namespaces",
    "allowed_fields",
    "delivery_profiles",
    "limits",
    "device_actions_enabled"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1.0"
    },
    "role": {
      "enum": [
        "publisher",
        "receiver"
      ]
    },
    "supported_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "0.1.0"
      }
    },
    "event_names": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "activity.summary"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "foreground_duration"
      }
    },
    "application_namespaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{0,31}$"
      }
    },
    "allowed_fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "contains": {
        "const": "foreground_duration_ms"
      },
      "items": {
        "enum": [
          "foreground_duration_ms",
          "label"
        ]
      }
    },
    "delivery_profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "direct-https-v1",
          "direct-local-tls-v1",
          "direct-loopback-test-v1"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_event_bytes",
        "max_batch_bytes",
        "max_apps_per_page",
        "max_pages",
        "max_fresh_events_per_hour",
        "max_history_age_ms",
        "max_history_bytes",
        "max_attempts_per_cycle"
      ],
      "properties": {
        "max_event_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 16384
        },
        "max_batch_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 65536
        },
        "max_apps_per_page": {
          "const": 32
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "max_fresh_events_per_hour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "max_history_age_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "max_history_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "max_attempts_per_cycle": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "device_actions_enabled": {
      "const": false
    }
  }
}
