{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prepared OAP host capability catalog 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "reviewed_at",
    "implementation_status",
    "selected_host_id",
    "production_selectable",
    "policy",
    "status_vocabulary",
    "sources",
    "hosts"
  ],
  "properties": {
    "format_version": {
      "const": "1.0.0"
    },
    "reviewed_at": {
      "const": "2026-10-04"
    },
    "implementation_status": {
      "const": "not_implemented"
    },
    "selected_host_id": {
      "type": "null"
    },
    "production_selectable": {
      "const": false
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows_reference_sufficient_to_proceed",
        "linux_portability",
        "no_intermediary",
        "existing_agent_required",
        "new_agent_substitute_allowed",
        "catalog_is_runtime_configuration",
        "tokens_or_account_actions_performed"
      ],
      "properties": {
        "windows_reference_sufficient_to_proceed": {
          "const": true
        },
        "linux_portability": {
          "const": "on_hold_unverified"
        },
        "no_intermediary": {
          "const": true
        },
        "existing_agent_required": {
          "const": true
        },
        "new_agent_substitute_allowed": {
          "const": false
        },
        "catalog_is_runtime_configuration": {
          "const": false
        },
        "tokens_or_account_actions_performed": {
          "const": false
        }
      }
    },
    "status_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documented",
        "unverified",
        "not_supported",
        "not_applicable"
      ],
      "properties": {
        "documented": {
          "const": "Official source describes the primitive; account/runtime support is not established."
        },
        "unverified": {
          "const": "Required capability, account access or actual behavior is not established."
        },
        "not_supported": {
          "const": "Official source explicitly excludes this named surface or production primitive."
        },
        "not_applicable": {
          "const": "The primitive does not apply to this branch."
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "title",
          "url",
          "verified_at",
          "type"
        ],
        "properties": {
          "id": {
            "enum": [
              "openai_events",
              "openai_tunnel",
              "openai_trigger",
              "openai_workspace_auth",
              "openai_access_tokens",
              "openai_dot_context",
              "openai_workspace_memory",
              "openai_trigger_example",
              "claude_connectors",
              "claude_schedules",
              "claude_tunnel",
              "gemini_custom_apps",
              "gemini_schedules",
              "codex_app_server"
            ]
          },
          "provider": {
            "enum": [
              "OpenAI",
              "Anthropic",
              "Google"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://(?:developers\\.openai\\.com|learn\\.chatgpt\\.com|support\\.claude\\.com|platform\\.claude\\.com|support\\.google\\.com)/",
            "maxLength": 2048
          },
          "verified_at": {
            "const": "2026-10-04"
          },
          "type": {
            "const": "official_documentation"
          }
        }
      }
    },
